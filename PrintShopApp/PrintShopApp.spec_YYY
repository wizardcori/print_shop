# -*- mode: python ; coding: utf-8 -*-

import glob
import os

# 1. 빌드 시점에 프로젝트 내의 모든 ui_*.py 파일들을 자동으로 수집
ui_py_files = glob.glob("**/ui_*.py", recursive=True)
auto_hidden_imports = []

for file_path in ui_py_files:
    if "build" in file_path or "dist" in file_path or ".venv" in file_path or "venv" in file_path:
        continue
    # 파일 경로를 파이썬 모듈 네임스페이스 형식으로 변환
    mod_path = os.path.splitext(file_path)[0].replace(os.sep, ".")
    if mod_path.startswith("src."):
        mod_path = mod_path[4:]  # src/ 폴더 구조에 맞게 조정
    auto_hidden_imports.append(mod_path)

a = Analysis(
    ['main_app.py'],
    pathex=['.', 'src'],
    binaries=[('C:/Espressif/tools/python/python311.dll', '.'), ('C:/Espressif/tools/python/vcruntime140.dll', '.'), ('C:/Espressif/tools/python/vcruntime140_1.dll', '.')],
    datas=[('src/LinkBox/templates', 'LinkBox/templates'), ('src/LinkShare/web/templates', 'LinkShare/web/templates'), ('.env.feature.runtime', '.'), ('src/LinkBox/ui', 'LinkBox/ui')],
    hiddenimports=[
        'ui_print_shop_app',
        'ui_linkbox',
        'ui_linkshare_layout',
        'ui_hotspot_settings',
        'ui_print_monitor_sound_settings',
        'ui_user_screen_setting',
    ] + auto_hidden_imports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
#    excludes=['LinkBox.printer_monitor_service'],    
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='PrintShopApp',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    version='version_info.txt',
    uac_admin=False,
)

