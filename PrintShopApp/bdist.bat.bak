@echo off
chcp 65001 > nul
title PrintShopApp Packaging Script

echo ===================================================
echo   Starting PrintShopApp Distribution Build (PyInstaller)
echo ===================================================
echo.

echo [0/3] Preparing the Python environment...
call setup.bat nopause
if errorlevel 1 goto error_exit
echo.

if not exist ".venv\Scripts\python.exe" goto error_exit

rem Build-time feature flags are read only from .env.feature.buildtime.
rem .env.feature.runtime is intentionally not read here: runtime settings
rem must not change which modules are compiled into the executable.
set "USE_PRINTER_WATCH=false"
set "USE_BUILD_TIME_TEST=false"
if exist ".env.feature.buildtime" for /f "usebackq eol=# tokens=1,* delims==" %%A in (".env.feature.buildtime") do if /i "%%A"=="USE_PRINTER_WATCH" set "USE_PRINTER_WATCH=%%B"
if exist ".env.feature.buildtime" for /f "usebackq eol=# tokens=1,* delims==" %%A in (".env.feature.buildtime") do if /i "%%A"=="USE_BUILD_TIME_TEST" set "USE_BUILD_TIME_TEST=%%B"
set "MODE=production"
if exist ".env" for /f "usebackq eol=# tokens=1,* delims==" %%A in (".env") do if /i "%%A"=="MODE" set "MODE=%%B"

rem Normalize values so entries such as ` USE_PRINTER_WATCH = false `
rem and uppercase TRUE/FALSE produce deterministic build behavior.
for /f %%A in ('powershell.exe -NoProfile -Command "$v='%USE_PRINTER_WATCH%'.Trim().ToLowerInvariant(); if ($v -in @('1','true','yes','on')) {'true'} else {'false'}"') do set "USE_PRINTER_WATCH=%%A"
for /f %%A in ('powershell.exe -NoProfile -Command "$v='%USE_BUILD_TIME_TEST%'.Trim().ToLowerInvariant(); if ($v -in @('1','true','yes','on')) {'true'} else {'false'}"') do set "USE_BUILD_TIME_TEST=%%A"
for /f %%A in ('powershell.exe -NoProfile -Command "$v='%MODE%'.Trim().ToLowerInvariant(); if ($v -eq 'development') {'development'} else {'production'}"') do set "MODE=%%A"
set "PYINSTALLER_EXCLUDES="
if /i "%USE_PRINTER_WATCH%"=="false" set "PYINSTALLER_EXCLUDES=--exclude-module LinkBox.src.printer_monitor_service"
if /i "%USE_PRINTER_WATCH%"=="0" set "PYINSTALLER_EXCLUDES=--exclude-module LinkBox.src.printer_monitor_service"
if /i "%USE_PRINTER_WATCH%"=="no" set "PYINSTALLER_EXCLUDES=--exclude-module LinkBox.src.printer_monitor_service"
if /i "%USE_PRINTER_WATCH%"=="off" set "PYINSTALLER_EXCLUDES=--exclude-module LinkBox.src.printer_monitor_service"
echo [BUILD CONFIG] MODE=%MODE%
echo [BUILD CONFIG] USE_PRINTER_WATCH=%USE_PRINTER_WATCH%
echo [BUILD CONFIG] USE_BUILD_TIME_TEST=%USE_BUILD_TIME_TEST%
powershell.exe -NoProfile -Command "$content = '# Generated by bdist.bat - do not edit.' + [Environment]::NewLine + ('BUILD_MODE = ' + [string]::Concat([char]39, '%MODE%', [char]39)) + [Environment]::NewLine + ('BUILD_USE_PRINTER_WATCH = ' + ('%USE_PRINTER_WATCH%' -match '^(?i:true|1|yes|on)$').ToString()) + [Environment]::NewLine + ('BUILD_USE_BUILD_TIME_TEST = ' + ('%USE_BUILD_TIME_TEST%' -match '^(?i:true|1|yes|on)$').ToString()); Set-Content -Path 'src\build_config_generated.py' -Value $content -Encoding UTF8"
if errorlevel 1 goto error_exit

echo [1/2] Activating virtual environment and ensuring PyInstaller is installed...
".venv\Scripts\python.exe" -m pip install pyinstaller > nul

echo.
echo [2/2] Building executable package (onedir mode)...
".venv\Scripts\pyinstaller.exe" --noconsole --onedir --noconfirm --name "PrintShopApp" %PYINSTALLER_EXCLUDES% --paths "." --paths "src" --add-binary "C:\Espressif\tools\python\python311.dll;." --add-binary "C:\Espressif\tools\python\vcruntime140.dll;." --add-binary "C:\Espressif\tools\python\vcruntime140_1.dll;." --add-data "LinkBox\templates;LinkBox/templates" --add-data "LinkShare\templates;LinkShare/templates" --add-data ".env.feature.runtime;." --add-data "LinkBox\src\ui;ui" --log-level=DEBUG src\main_app.py

echo.
echo ===================================================
echo   Build complete! 
echo   Check the 'dist/PrintShopApp' folder for your executable.
echo ===================================================
echo.

set "ISCC="
for /f "delims=" %%I in ('where iscc 2^>nul') do set "ISCC=%%I"
if not defined ISCC if exist "%ProgramFiles(x86)%\Inno Setup 6\ISCC.exe" set "ISCC=%ProgramFiles(x86)%\Inno Setup 6\ISCC.exe"
if not defined ISCC if exist "%ProgramFiles%\Inno Setup 6\ISCC.exe" set "ISCC=%ProgramFiles%\Inno Setup 6\ISCC.exe"
if not defined ISCC if exist "%LOCALAPPDATA%\Programs\Inno Setup 6\ISCC.exe" set "ISCC=%LOCALAPPDATA%\Programs\Inno Setup 6\ISCC.exe"
if not defined ISCC goto install_inno
echo [3/3] Creating Windows installer...
if not exist installer mkdir installer
set "SETUP_NAME=PrintShopApp_Setup"
if /i "%MODE%"=="development" set "SETUP_NAME=PrintShopAppDev_Setup"
if exist "installer\%SETUP_NAME%.exe" del /f /q "installer\%SETUP_NAME%.exe" > nul 2>&1
"%ISCC%" /DSourceDir="%CD%" /DOutputBaseFilename="%SETUP_NAME%" installer.iss
if errorlevel 1 goto error_exit
echo Installer created: installer\%SETUP_NAME%.exe
goto done

:install_inno
echo [INFO] Inno Setup compiler was not found. Installing Inno Setup...
where winget > nul 2>&1
if errorlevel 1 goto no_inno
winget install --id JRSoftware.InnoSetup --exact --silent --accept-source-agreements --accept-package-agreements
if errorlevel 1 goto no_inno
set "PATH=%PATH%;%ProgramFiles(x86)%\Inno Setup 6;%ProgramFiles%\Inno Setup 6"
if exist "%ProgramFiles(x86)%\Inno Setup 6\ISCC.exe" set "ISCC=%ProgramFiles(x86)%\Inno Setup 6\ISCC.exe"
if not defined ISCC if exist "%ProgramFiles%\Inno Setup 6\ISCC.exe" set "ISCC=%ProgramFiles%\Inno Setup 6\ISCC.exe"
if not defined ISCC if exist "%LOCALAPPDATA%\Programs\Inno Setup 6\ISCC.exe" set "ISCC=%LOCALAPPDATA%\Programs\Inno Setup 6\ISCC.exe"
if not defined ISCC goto no_inno
echo [3/3] Creating Windows installer...
if not exist installer mkdir installer
set "SETUP_NAME=PrintShopApp_Setup"
if /i "%MODE%"=="development" set "SETUP_NAME=PrintShopAppDev_Setup"
if exist "installer\%SETUP_NAME%.exe" del /f /q "installer\%SETUP_NAME%.exe" > nul 2>&1
"%ISCC%" /DSourceDir="%CD%" /DOutputBaseFilename="%SETUP_NAME%" installer.iss
if errorlevel 1 goto error_exit
echo Installer created: installer\%SETUP_NAME%.exe
goto done

:no_inno
echo [WARNING] Inno Setup compiler (ISCC.exe) was not found.
echo Portable build is ready in dist\PrintShopApp.
echo Install Inno Setup and run bdist.bat again for the installer.

:done
pause
exit /b

:error_exit
echo.
echo [FAILED] Build terminated due to an error.
pause
exit /b
