# 기능 플래그 RUN TIME 설정 파일
# 변수화

# Runtime feature values can disable an included feature.
# Runtime feature variables.
# These values are read when the application starts and are not packaged.

# Reserved for runtime-only test features.
USE_RUN_TIME_TEST=false
USE_RUN_TIME_TEST2=1        # range[1...5],def[1]
USE_RUN_TIME_TEST3=yes      # min[no],max[yes],def[yes]
