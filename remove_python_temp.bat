@echo off
chcp 65001 >nul
echo ========================================================
echo   Python 임시 파일(__pycache__, .pyc, .pyd) 청소 시작...
echo ========================================================

REM 1. __pycache__ 폴더 일괄 삭제
for /d /r . %%d in (__pycache__) do (
    if exist "%%d" (
        rd /s /q "%%d"
        echo [삭제된 폴더] %%d
    )
)

REM 2. .pyc, .pyo, .pyd 파일 일괄 삭제
for /r . %%f in (*.pyc *.pyo *.pyd) do (
    if exist "%%f" (
        del /f /q "%%f"
        echo [삭제된 파일] %%f
    )
)

echo ========================================================
echo   ✨ 파이썬 임시 파일 청소가 완료되었습니다!
echo ========================================================
pause